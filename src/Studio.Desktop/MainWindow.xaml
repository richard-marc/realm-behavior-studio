<Window x:Class="Studio.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Studio.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Realm Behavior Studio" Style="{StaticResource {x:Type Window}}" Width="1500" Height="1000" MinWidth="1080" MinHeight="740" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><local:SpriteConverter x:Key="Sprite"/><local:EventToneConverter x:Key="EventTone"/>
  <DataTemplate x:Key="EntityChoiceTemplate"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding SpriteId, Converter={StaticResource Sprite}}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/><TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></Grid></DataTemplate>
 </Window.Resources>
 <Border BorderBrush="#303238" BorderThickness="1"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,0,0,0">
   <DockPanel LastChildFill="False">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"><Border Width="24" Height="24" Background="#263C32" CornerRadius="6" Margin="0,0,10,0"><TextBlock Text="r" FontWeight="Bold" FontSize="19" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/></Border><TextBlock Text="Realm" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/><TextBlock Text=" /  Behavior Studio" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button Style="{StaticResource IconButton}" Content="↶" Click="Undo" ToolTip="Undo · Ctrl+Z"/><Button Style="{StaticResource IconButton}" Content="↷" Click="Redo" ToolTip="Redo · Ctrl+Y" Margin="0,0,16,0"/>
     <Button Style="{StaticResource QuietButton}" Content="Open" Click="OpenProject" Margin="0,0,6,0"/><Button Content="Save" Click="SaveProject" ToolTip="Save project · Ctrl+S" Margin="0,0,6,0"/><Button Style="{StaticResource QuietButton}" Content="Export ↗" Click="Export" Margin="0,0,22,0"/>
     <Button Style="{StaticResource IconButton}" Content="−" Click="MinimizeWindow" ToolTip="Minimize"/><Button Style="{StaticResource IconButton}" Content="□" Click="MaximizeWindow" ToolTip="Maximize / restore"/><Button Style="{StaticResource IconButton}" Content="×" Click="CloseWindow" ToolTip="Close" Margin="0,0,8,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="12,16,12,0">
   <Grid.RowDefinitions><RowDefinition x:Name="EditorRow" Height="*" MinHeight="280"/><RowDefinition Height="10"/><RowDefinition x:Name="ConsoleRow" Height="260" MinHeight="48"/></Grid.RowDefinitions>
   <Grid x:Name="EditorGrid">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="230" MinWidth="175"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="420"/><ColumnDefinition Width="10"/><ColumnDefinition x:Name="InspectorColumn" Width="310" MinWidth="260"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="12">
     <TabControl x:Name="LibraryTabs">
      <TabItem Header="Entities"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Grid><TextBox x:Name="Search" Tag="Search entities" TextChanged="SearchChanged" Padding="30,8,10,8" Margin="0,0,0,12" ToolTip="Search entities"/><TextBlock Text="⌕" FontSize="19" Foreground="{StaticResource Muted}" Margin="10,3,0,0" IsHitTestVisible="False"/></Grid>
       <TextBlock x:Name="LibraryCount" Grid.Row="1" Style="{StaticResource Label}" Margin="4,0,0,10"/>
       <ListBox x:Name="Library" Grid.Row="2" SelectionChanged="EntitySelected"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Converter={StaticResource Sprite}}" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding Id}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      </Grid></TabItem>
      <TabItem Header="Actions"><DockPanel><TextBox x:Name="PrimitiveSearch" Tag="Find an action" DockPanel.Dock="Top" TextChanged="PrimitiveSearchChanged" ToolTip="Search behavior constructors" Margin="0,0,0,12"/><Button x:Name="UseActionButton" DockPanel.Dock="Bottom" Content="＋ Use action" Click="AddPrimitive" Margin="0,10,0,0"/><ListBox x:Name="Primitives" DisplayMemberPath="Name"/></DockPanel></TabItem>
     </TabControl>
    </Border>
    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="Resize library"/>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="6,0,6,18"><Image x:Name="EntitySprite" DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/><StackPanel><TextBlock x:Name="EntityTitle" Text="Choose an entity" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="EntitySubtitle" Text="Encounter workspace" Style="{StaticResource Label}" Margin="0,4,0,0"/><TextBlock x:Name="SharedTemplateNotice" Visibility="Collapsed" Style="{StaticResource Label}" Margin="0,5,0,0"/><StackPanel x:Name="DefinitionBanner" Visibility="Collapsed" Orientation="Horizontal" Margin="0,6,0,0"><TextBlock x:Name="DefinitionTitle" Style="{StaticResource Label}" VerticalAlignment="Center"/><Button x:Name="DefinitionBack" Content="Return to encounter" Click="ReturnToEncounter" Style="{StaticResource QuietButton}" Margin="12,0,0,0"/></StackPanel></StackPanel></DockPanel>
     <TabControl x:Name="WorkspaceTabs" Grid.Row="1">
      <TabItem Header="Encounter"><Border Background="{StaticResource Panel}" CornerRadius="10" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <WrapPanel Margin="0,0,0,12">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="▶  Play" Click="TogglePlay" MinWidth="94"/><Button Style="{StaticResource IconButton}" Content="↻" Click="Restart" ToolTip="Restart · F5" Margin="6,0,0,0"/><Button Style="{StaticResource IconButton}" Content="■" Click="Stop" ToolTip="Stop"/><Button Style="{StaticResource IconButton}" Content="↦" Click="Step" ToolTip="Step forward 100 ms"/><Button x:Name="CombatPreviewButton" Style="{StaticResource QuietButton}" Content="Preview attacks" Click="ToggleCombatPreview" ToolTip="Native density plus fresh damage tests at selected player start points" Margin="8,0,0,0"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="12,0,0,0"><ComboBox x:Name="Playback" Width="76" SelectedIndex="2" ToolTip="Playback speed"><ComboBoxItem Content="0.25×"/><ComboBoxItem Content="0.5×"/><ComboBoxItem Content="1×"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/></ComboBox><Button Style="{StaticResource IconButton}" Content="⌖" Click="ResetCamera" ToolTip="Reset camera" Margin="6,0,0,0"/><Button Style="{StaticResource QuietButton}" Content="Test phase" Click="TestPhase" ToolTip="Choose a phase in Behavior first" Margin="6,0,0,0"/></StackPanel>
        <Button x:Name="ArenaEditButton" Style="{StaticResource QuietButton}" Content="Edit arena" Click="ToggleArenaEditor" Margin="6,0,0,0" ToolTip="Paint native ground and obstacles; place encounter spawns"/>
       </WrapPanel>
       <StackPanel x:Name="ArenaControls" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,10"/>
              <StackPanel x:Name="CombatPreviewControls" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,10">
        <WrapPanel><ComboBox x:Name="CombatMode" Width="166" SelectedIndex="0" SelectionChanged="CombatModeChanged" ToolTip="Choose how to display the same recorded tests"><ComboBoxItem Content="Projectile density"/><ComboBoxItem Content="Health lost"/><ComboBoxItem Content="No damage observed"/></ComboBox><ComboBox x:Name="CombatScenario" Width="96" Visibility="Collapsed" SelectionChanged="CombatScenarioChanged" Margin="6,0,0,0" ToolTip="Inspect a tested seed without rerunning"/><Button x:Name="CombatRerun" Content="Run again" Click="RerunCombatPreview" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/><Button x:Name="CombatExport" Content="Export results" Click="ExportCombatPreview" IsEnabled="False" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/></WrapPanel>
        <Expander x:Name="CombatSettings" Header="Test settings" Margin="0,6,0,0"><WrapPanel Margin="0,8,0,0"><ComboBox x:Name="CombatDuration" Width="72" SelectedIndex="0" ToolTip="Duration of each native run"><ComboBoxItem Content="3 s"/><ComboBoxItem Content="5 s"/><ComboBoxItem Content="10 s"/></ComboBox><ComboBox x:Name="CombatGrid" Width="88" Margin="6,0,6,0" SelectedIndex="0" ToolTip="5 × 5 or 9 × 9 around the arena center; 1 start uses the Player start position"><ComboBoxItem Content="5 × 5"/><ComboBoxItem Content="9 × 9"/><ComboBoxItem Content="1 start"/></ComboBox><TextBox x:Name="CombatSpacing" Text="2" Width="46" ToolTip="Distance between tested starts, in tiles"/><ComboBox x:Name="CombatInputMode" Width="144" Margin="6,0,0,0" SelectedIndex="0" ToolTip="Movement intent reruns from every tested start. Recorded inputs retain exact movement, firing and absolute aim coordinates; any remaining duration idles."><ComboBoxItem Content="Stationary"/><ComboBoxItem Content="Move right"/><ComboBoxItem Content="Move left"/><ComboBoxItem Content="Move up"/><ComboBoxItem Content="Move down"/><ComboBoxItem Content="Four directions"/><ComboBoxItem Content="Recorded inputs"/></ComboBox><CheckBox x:Name="CombatFiring" Content="Fire at enemy start" Margin="8,4,0,0"/><ComboBox x:Name="CombatSeedCount" Width="120" Margin="6,0,6,0" SelectedIndex="0" ToolTip="Fresh native runs for the current seed or the next three seeds"><ComboBoxItem Content="One seed"/><ComboBoxItem Content="Three seeds"/></ComboBox><CheckBox x:Name="CombatPhase" Content="Selected phase" Margin="8,4,0,0" ToolTip="Select a named State first; setup before that phase is bypassed"/></WrapPanel></Expander>
        <TextBlock x:Name="CombatPointInfo" Text="Choose a dot to inspect its native test." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="2,8,2,0"/>
       </StackPanel>
       <Border Grid.Row="2" Background="#101215" CornerRadius="8" ClipToBounds="True"><local:EncounterViewport x:Name="Viewport" Focusable="True"/></Border>
       <DockPanel Grid.Row="3" Margin="2,10,2,0"><TextBlock Text="XML weapons" Foreground="#AAB09C" FontSize="11" ToolTip="Real weapon definitions and client collision geometry; full player lifecycle remains pending."/><TextBlock x:Name="Coverage" Text="Local simulation · partial fidelity" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/></DockPanel>
      </Grid></Border></TabItem>
      <TabItem Header="Behavior"><Border Background="{StaticResource Panel}" CornerRadius="10" Padding="12"><Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid.ColumnDefinitions><ColumnDefinition Width="180" MinWidth="100"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,10"><TextBlock x:Name="SelectionCount" Text="1 selected" Style="{StaticResource Label}" VerticalAlignment="Center" ToolTip="Ctrl-click to add/remove · Shift-click for a range · drag to move · Ctrl-drag to copy"/><Button Content="Commands" Style="{StaticResource QuietButton}" Click="OpenCommands" HorizontalAlignment="Right" ToolTip="Search actions, phases and editing commands · Ctrl+K"/></DockPanel>
       <TreeView x:Name="BehaviorTree" Grid.Row="1" SelectedItemChanged="NodeSelected"/>
       <GridSplitter Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
       <ScrollViewer x:Name="GraphScroll" Grid.Row="1" Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><local:StateGraph x:Name="Graph" HorizontalAlignment="Left" VerticalAlignment="Top"/></ScrollViewer>
       <Border x:Name="CommandPanel" Grid.Row="1" Grid.ColumnSpan="3" Panel.ZIndex="10" Visibility="Collapsed" Background="#222428" BorderBrush="#464C57" BorderThickness="1" CornerRadius="10" Padding="14" Width="420" MaxHeight="380" HorizontalAlignment="Right" VerticalAlignment="Top"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="CommandSearch" Tag="Find a phase or command…" TextChanged="CommandSearchChanged" PreviewKeyDown="CommandKeyDown"/><ListBox x:Name="CommandResults" Grid.Row="1" Margin="0,10,0,8" MouseDoubleClick="ExecuteSelectedCommand" PreviewKeyDown="CommandKeyDown"><ListBox.ItemTemplate><DataTemplate><StackPanel Opacity="{Binding Enabled, Converter={x:Static local:BooleanOpacityConverter.Instance}}"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Label}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="2" Text="↑ ↓ select · Enter run · Esc close" Style="{StaticResource Label}" FontSize="11"/></Grid></Border>
       <Expander x:Name="PhaseReview" Grid.Row="2" Grid.ColumnSpan="3" Header="Phase review" Margin="0,12,0,0">
        <StackPanel><TextBlock Text="First match wins · child phases before parents" Style="{StaticResource Label}" Margin="4,6,4,8" ToolTip="Transitions run in numbered source order. A phase enters its first nested phase. Actions in parent phases remain active. Select a transition, then Organize, to change its priority."/>
         <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PhaseDiagnostics"/></ScrollViewer>
        </StackPanel>
       </Expander>
      </Grid></Border></TabItem>
      <TabItem x:Name="SourceWorkspace" Header="Source"><Border Background="{StaticResource Panel}" CornerRadius="10" Padding="12"><DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="SourceFiles" DisplayMemberPath="Title" SelectionChanged="SourceFileSelected" ToolTip="Project source files" Margin="0,0,8,0"/><Button Grid.Column="1" Content="Add file" Style="{StaticResource QuietButton}" Click="AddSourceFile" ToolTip="Include an original server dependency in this project" Margin="0,0,8,0"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="DiscardSourceDraftButton" Content="Discard draft" Click="DiscardSourceDraft" Visibility="Collapsed" Style="{StaticResource QuietButton}" Margin="0,0,6,0"/><Button Content="Apply" Click="ApplySource" ToolTip="Validate every project source file and apply changes"/></StackPanel></Grid><TextBlock x:Name="SourceFileNotice" DockPanel.Dock="Bottom" Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBox x:Name="SourceEditor" TextChanged="SourceDraftChanged" Margin="0" FontFamily="Cascadia Code, Consolas" FontSize="12" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/></DockPanel></Border></TabItem>
      <TabItem Header="Details"><Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14"><TabControl x:Name="DetailsTabs"><TabItem Header="Resources"><TextBox x:Name="ResourceInfo" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem><TabItem Header="Runtime"><TextBox x:Name="TimerInfo" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Code, Consolas" VerticalScrollBarVisibility="Auto"/></TabItem>
       <TabItem Header="Actors"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Live native actors" FontWeight="SemiBold" Margin="0,6,0,8"/><TextBlock DockPanel.Dock="Bottom" Text="Parent IDs come from the game. An unassigned parent does not prove that an actor was never spawned by another actor. Orders address nearby matching entities, regardless of parent." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/><TextBlock x:Name="RuntimeActorInfo" DockPanel.Dock="Bottom" Text="Play an encounter to inspect its actors." TextWrapping="Wrap" Margin="0,12,0,0"/><ListBox x:Name="RuntimeActors" ItemTemplate="{StaticResource EntityChoiceTemplate}" SelectionChanged="RuntimeActorSelected"/></DockPanel></TabItem>
     </TabControl></Border></TabItem>
      <TabItem Header="Fragments"><Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DockPanel><TextBox x:Name="FragmentSearch" DockPanel.Dock="Top" Tag="Find a fragment" TextChanged="FragmentSearchChanged" Margin="0,0,0,10"/><WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><Button x:Name="FragmentCaptureButton" Content="Save selection" Click="CaptureFragmentSelection" Style="{StaticResource QuietButton}"/><Button Content="Import file" Click="OpenFragmentFile" Style="{StaticResource QuietButton}"/></WrapPanel><ListBox x:Name="FragmentLibrary" DisplayMemberPath="Name" SelectionChanged="FragmentSelected"/></DockPanel><ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="FragmentHeading" Text="Reusable encounter fragments" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="FragmentInfo" Text="Select phases or actions in Behavior, then save their source as a reusable template." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,14"/><StackPanel x:Name="FragmentNameFields" Visibility="Collapsed"><TextBlock Text="Name"/><TextBox x:Name="FragmentName"/><TextBlock Text="Description" Margin="0,10,0,0"/><TextBox x:Name="FragmentDescription" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56"/></StackPanel><StackPanel x:Name="FragmentFields" Margin="0,10,0,0"/><StackPanel x:Name="FragmentPhases" Margin="0,10,0,0"/><CheckBox x:Name="FragmentSelfOrders" Content="Retarget self orders to this encounter" IsChecked="True" Visibility="Collapsed" Checked="FragmentOptionsChanged" Unchecked="FragmentOptionsChanged"/><WrapPanel Margin="0,14,0,0"><Button x:Name="FragmentSaveButton" Content="Save template" Click="SaveFragmentTemplate" Visibility="Collapsed"/><Button x:Name="FragmentPreviewButton" Content="Preview insertion" Click="PreviewFragmentInsertion" IsEnabled="False"/><Button x:Name="FragmentInsertButton" Content="Insert" Click="InsertFragment" IsEnabled="False" Margin="6,0,0,0"/><Button x:Name="FragmentShareButton" Content="Export file" Click="ShareFragmentFile" IsEnabled="False" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/></WrapPanel><Expander Header="Source preview" Margin="0,14,0,0"><TextBox x:Name="FragmentPreview" IsReadOnly="True" FontFamily="Cascadia Code, Consolas" FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="360"/></Expander></StackPanel></ScrollViewer></Grid></Border></TabItem>
      <TabItem Header="Timeline"><Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14"><DockPanel>
       <StackPanel DockPanel.Dock="Top"><WrapPanel><Button x:Name="TimelinePlayButton" Content="▶ Play recording" Click="PlayRecordedTimeline" Style="{StaticResource QuietButton}"/><Button x:Name="TimelineLiveButton" Content="Live from here" Click="ContinueLiveTimeline" Style="{StaticResource QuietButton}"/><Button x:Name="TimelineSaveButton" Content="Save recording" Click="SaveTimelineReplay" Style="{StaticResource QuietButton}"/><Button Content="Open recording" Click="OpenTimelineReplay" Style="{StaticResource QuietButton}"/><Button x:Name="TimelineCancelButton" Content="Cancel seek" Click="CancelTimelineReplay" Style="{StaticResource QuietButton}"/></WrapPanel><TextBlock x:Name="TimelineInfo" Text="Play an encounter to record its native events." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,10,2,12"/>
       <local:EncounterTimeline x:Name="TimelineVisual" Height="220" Margin="0,0,0,12"/><DockPanel><TextBlock x:Name="TimelineTime" DockPanel.Dock="Right" Text="0.000 / 0.000 s" Margin="12,5,0,0" FontFamily="Cascadia Mono, Consolas"/><Button x:Name="TimelineSeekButton" Content="Seek" Click="SeekTimeline" DockPanel.Dock="Right" Style="{StaticResource QuietButton}"/><Slider x:Name="TimelineSeek" Minimum="0" Maximum="5" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="TimelineSeekChanged" ToolTip="Seek in native 5 ms samples, then press Seek"/></DockPanel>
       <DockPanel Margin="0,12,0,8"><Button x:Name="TimelineGoButton" DockPanel.Dock="Right" Content="Go to event" Click="GoToTimelineEvent" Style="{StaticResource QuietButton}"/><TextBlock x:Name="TimelineEventInfo" Text="Choose a marker or event to inspect its source and replay position." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,5,12,0"/></DockPanel></StackPanel>
       <ListBox x:Name="TimelineEvents" SelectionChanged="TimelineEventSelected"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" FontSize="12"/></DataTemplate></ListBox.ItemTemplate></ListBox>
      </DockPanel></Border></TabItem>
      <TabItem x:Name="MapWorkspace" Header="Map"><Border Background="{StaticResource Panel}" CornerRadius="10" Padding="12"><DockPanel>
       <StackPanel x:Name="MapToolbar" DockPanel.Dock="Top" Margin="0,0,0,12">
        <DockPanel Margin="2,0,2,10"><StackPanel><TextBlock x:Name="MapHeading" Text="Native map editor" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="MapInfo" Text="Open and edit the game's .wmap files" Style="{StaticResource Label}" Margin="0,4,0,0"/></StackPanel></DockPanel>
        <WrapPanel Margin="0,0,0,8"><Button Content="Open map" Click="OpenMapFile"/><Button x:Name="MapSave" Content="Save map" Click="SaveMapFile" Margin="6,0,0,0"/><Button Content="From arena" Click="ArenaToMap" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/><Button x:Name="MapUse" Content="Use in arena" Click="MapToArena" Style="{StaticResource QuietButton}" Margin="6,0,0,0" ToolTip="Select the current encounter enemy in a compatible 128×128 map"/><Button Content="Fit" Click="FitMap" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/><Button Content="Focus tile" Click="FocusMapTile" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/></WrapPanel>
        <WrapPanel x:Name="MapTools"/>
       </StackPanel><Border Background="#101215" CornerRadius="8" ClipToBounds="True"><local:NativeMapViewport x:Name="MapCanvas"/></Border>
      </DockPanel></Border></TabItem>
     </TabControl>
    </Grid>
    <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="Resize inspector"/>
    <Border Grid.Column="4" Background="{StaticResource Panel}" CornerRadius="10" Padding="12"><TabControl>
     <TabItem x:Name="ParametersTab" Header="Parameters"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Inspector" Margin="4,2,4,14"/></ScrollViewer></TabItem>
     <TabItem x:Name="PlayerTab" Header="Player"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,2,4,14">
      <TextBlock Text="Test player" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="WASD to move · mouse to aim and fire" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,6,0,22"/>
      <TextBlock Text="Weapon"/><TextBox x:Name="WeaponSearch" Tag="Find a weapon…" TextChanged="WeaponSearchChanged" Margin="0,6,0,6"/>
      <ComboBox x:Name="Weapons" SelectionChanged="WeaponSelected" MaxDropDownHeight="320">
       <ComboBox.ItemTemplate><DataTemplate><DockPanel LastChildFill="True"><Image Source="{Binding Id, Converter={StaticResource Sprite}}" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ComboBox.ItemTemplate>
       <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="IsEnabled" Value="{Binding Supported}"/><Setter Property="ToolTip" Value="{Binding Limitation}"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers></Style></ComboBox.ItemContainerStyle>
      </ComboBox>
      <TextBlock x:Name="WeaponInfo" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,8,0,16"/>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Attack"/><TextBox x:Name="PlayerAttack" Text="50" ToolTip="Base attack before weapon bonuses"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Dexterity"/><TextBox x:Name="PlayerDexterity" Text="50" ToolTip="Base dexterity sets firing cadence; weapon RateOfFire multiplies it"/></StackPanel></Grid>
      <TextBlock Text="Health"/><TextBox x:Name="PlayerHp" Text="1000" Margin="0,6,0,16"/>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Speed"/><TextBox x:Name="PlayerSpeed" Text="50" ToolTip="Normal-class movement formula from the original client"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Defense"/><TextBox x:Name="PlayerDefense" Text="0" ToolTip="Uses the original server's defense helper"/></StackPanel></Grid>
      <TextBlock Text="Random seed"/><TextBox x:Name="Seed" Text="7" Margin="0,6,0,16"/>
      <TextBlock Text="Arena size"/><TextBox x:Name="ArenaSize" Text="48" ToolTip="32–128 tiles" Margin="0,6,0,16"/>
      <Expander Header="Player start position" Margin="0,0,0,16"><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="X · tiles"/><TextBox x:Name="PlayerStartX" Text="70.5" ToolTip="Passable prototype arena position, before encounter entry"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Y · tiles"/><TextBox x:Name="PlayerStartY" Text="64.5" ToolTip="Passable prototype arena position, before encounter entry"/></StackPanel></Grid></Expander>
      <CheckBox x:Name="Spectator" Content="Spectator mode" ToolTip="Ignore incoming player hits"/><CheckBox x:Name="Invulnerable" Content="Invulnerability" ToolTip="Test override; not exported"/><CheckBox x:Name="Hitboxes" Content="Hitboxes" IsChecked="False" Checked="ViewportOptionsChanged" Unchecked="ViewportOptionsChanged"/><CheckBox x:Name="ArenaGrid" Content="Arena grid" Checked="ViewportOptionsChanged" Unchecked="ViewportOptionsChanged"/>
      <TextBlock Text="Original actor health override" Margin="0,18,0,0"/><Slider x:Name="BossHp" Minimum="1" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BossHpChanged" ToolTip="Available while the original encounter actor remains alive in this world."/>
      <Button Content="Apply &amp; restart" Click="Restart" Margin="0,8,0,0"/>
      <Expander Header="Simulation limits" Margin="0,18,0,0"><TextBlock Text="Weapon damage, spread, cadence, bonuses and supported shot procs use game XML. Collision uses client shapes at 5 ms samples. Unsupported weapons are disabled. Abilities, armor/ring loadouts, regeneration and the full player lifecycle are pending." Style="{StaticResource Label}" TextWrapping="Wrap"/></Expander>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Assistant"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,2,4,14">
      <TextBlock Text="Create with Codex" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Explain, refine, and test your encounter." Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,6,0,18"/>
      <ComboBox x:Name="Accounts" SelectionChanged="AccountSelected" Margin="0,0,0,8"/>
      <Button Content="Continue with ChatGPT" Click="SignIn"/><WrapPanel Margin="0,5,0,0"><Button Style="{StaticResource QuietButton}" Content="Add account" Click="AddAccount"/><Button Style="{StaticResource QuietButton}" Content="Sign out" Click="SignOut"/><Button Style="{StaticResource QuietButton}" Content="Cancel" Click="CancelAI"/></WrapPanel>
      <TextBlock x:Name="AccountStatus" Text="Optional · local editing works offline" TextWrapping="Wrap" Style="{StaticResource Label}" Margin="0,8,0,12"/>
      <Expander Header="Connection &amp; usage"><StackPanel><TextBlock Text="Uses eligible plan usage or credits. Live account testing is pending." Style="{StaticResource Label}" TextWrapping="Wrap"/><Button Style="{StaticResource QuietButton}" Content="Manage usage ↗" Click="ManageUsage"/><TextBlock Text="Codex executable"/><TextBox x:Name="CodexPath" Text="codex.exe" Margin="0,6,0,12"/><TextBlock Text="Model"/><TextBox x:Name="Model" Text="gpt-6.1-sol"/></StackPanel></Expander>
      <CheckBox x:Name="ShareContext" Content="Share selected encounter context" ToolTip="Selected entity, brief, supported primitives and requested traces"/>
      <TextBlock Text="Encounter brief" Margin="0,12,0,0"/><TextBox x:Name="Brief" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
      <TextBox x:Name="Conversation" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="200" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0"/>
      <TextBox x:Name="ChatPrompt" Tag="Describe your change…" AcceptsReturn="True" TextWrapping="Wrap" Height="70" ToolTip="Ask for an edit, explanation, or simulation" Margin="0,12,0,8"/><Button Style="{StaticResource PrimaryButton}" Content="Send" Click="SendChat"/>
      <Expander Header="Proposed changes" IsExpanded="True" Margin="0,18,0,0"><StackPanel><TextBox x:Name="Proposal" AcceptsReturn="True" TextWrapping="Wrap" Height="120" FontFamily="Cascadia Code, Consolas" FontSize="11"/><Button Content="Preview" Click="PreviewProposal" Margin="0,8,0,6"/><Button Content="Apply changes" Click="ApplyProposal"/><TextBlock x:Name="ProposalPreview" TextWrapping="Wrap" Style="{StaticResource Label}" Margin="0,12"/></StackPanel></Expander>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl></Border>
   </Grid>
   <Border Grid.Row="1" Width="36" Height="3" Background="#494E56" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/><GridSplitter Grid.Row="1" x:Name="ConsoleSplitter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ToolTip="Drag to resize the console" DragCompleted="PanelResized"/>
   <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="12,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel>
     <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Console" FontWeight="SemiBold" Margin="2,0,10,0"/><TextBlock x:Name="EventCount" Text="0 events" Style="{StaticResource Label}"/></StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="EventSearch" Tag="Filter events" Width="180" TextChanged="FilterEvents" ToolTip="Filter events" Margin="0,0,8,0" MinHeight="30" Padding="9,6"/><ComboBox x:Name="Breakpoint" Width="143" SelectedIndex="0" SelectionChanged="BreakpointChanged" ToolTip="Pause on an event" Margin="0,0,8,0"><ComboBoxItem Content="No breakpoint"/><ComboBoxItem Content="transition"/><ComboBoxItem Content="attack"/><ComboBoxItem Content="hit"/><ComboBoxItem Content="spawn"/><ComboBoxItem Content="death"/></ComboBox><Button Style="{StaticResource QuietButton}" Content="Save trace ↗" Click="SaveTrace"/><Button Style="{StaticResource IconButton}" Content="⌫" Click="ClearConsole" ToolTip="Clear visible console; trace is retained"/><Button x:Name="ExpandConsoleButton" Style="{StaticResource IconButton}" Content="↗" Click="ExpandConsole" ToolTip="Expand / restore console"/><Button x:Name="CollapseConsoleButton" Style="{StaticResource IconButton}" Content="⌄" Click="CollapseConsole" ToolTip="Collapse / restore console"/></StackPanel>
    </DockPanel>
    <Grid x:Name="ConsoleBody" Grid.Row="1" Margin="2,12,2,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="10,0,10,6"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="105"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="TIME" Style="{StaticResource Label}" FontSize="10"/><TextBlock Grid.Column="1" Text="EVENT" Style="{StaticResource Label}" FontSize="10"/><TextBlock Grid.Column="2" Text="DETAIL" Style="{StaticResource Label}" FontSize="10"/></Grid>
     <ListBox x:Name="Events" Grid.Row="1" SelectionChanged="EventSelected"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="105"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Event.Kind}" Foreground="{Binding Event.Kind, Converter={StaticResource EventTone}}" FontSize="12"/><TextBlock Grid.Column="2" Text="{Binding Event.Message}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
   </Grid></Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="18,0"><TextBlock x:Name="Status" Text="Loading source…" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Text="Space  play / pause    ·    Ctrl+S  save    ·    F5  restart" Foreground="#686E78" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
 </Grid></Border>
</Window>
